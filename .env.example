# Copy to .env to override the defaults in docker-compose.yml.

POSTGRES_USER=notification
POSTGRES_PASSWORD=notification
POSTGRES_DB=notification

RABBITMQ_USER=notification
RABBITMQ_PASSWORD=notification

LOG_LEVEL=info

# Retry ladder; every binary must use the same value (queue names and TTLs).
RETRY_DELAYS=5s,30s,2m,10m

# Mock provider behaviour.
FAILURE_RATE=0
LATENCY_MS=50

# Worker. PROVIDER_URL may point at https://webhook.site/<uuid> instead of the mock.
PROVIDER_URL=http://mockprovider:9090/
RATE_LIMIT_PER_SECOND=100
